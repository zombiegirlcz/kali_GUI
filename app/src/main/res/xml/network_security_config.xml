<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher only ever talks to localhost:
    - the X server started by the guest (Xvfb, TCP 6000)
    - the core app REST bridge (com.linux_core, TCP 1337)
  Both are plain TCP/HTTP on the loopback interface, so cleartext must be
  allowed for those hosts only. Everything else stays HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>