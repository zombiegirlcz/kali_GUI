#!/bin/zsh
# mbuild — Kali GUI build pipeline
# Usage: zsh mbuild <command>
#
# SYNC (vždy samostatně, před buildem):
#   sync  = git clone/pull PŘÍMO Z GITHUBU na Modal straně
#   clean = smaže src + gradle-cache na Volume (builds zůstávají)
#
# BUILD:
#   build    = Gradle APK build + download APK
#   all      = sync + Gradle build + download APK
#
# Než spustíš sync, musíš mít lokální commity na GitHubu:
#   git add -A && git commit -m "..." && git push
set -e
set -o pipefail

SRC="${PWD}"
CMD="${1:-}"

cd "$SRC"

case "$CMD" in
    sync)
        echo "=== SYNC (git clone/pull z GitHubu) ==="
        modal run modal_build.py::sync 2>&1 | tail -10
        ;;
    clean)
        echo "=== CLEAN (smaže src + gradle-cache na Volume) ==="
        modal run modal_build.py::clean 2>&1 | tail -5
        ;;
    all)
        echo "=== BUILD (sync + Gradle) ==="
        modal run modal_build.py::sync > build.log | cat
        modal run modal_build.py::build >> build.log | cat
        modal volume get --force -v kali-gui-build-data builds/kali-gui-debug.apk ~/Download 2>&1 || true
        ;;
    build)
        echo "=== GRADLE BUILD ==="
        modal run modal_build.py::build > build.log | cat
        modal volume get --force -v kali-gui-build-data builds/kali-gui-debug.apk ~/Download 2>&1 || true
        ;;
    *)
        echo "Usage: zsh mbuild [sync|clean|all|build]"
        exit 1
        ;;
esac
